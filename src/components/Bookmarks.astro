---
// Bookmarks component (scaffold).
//
// The markup below renders during the static build. The dynamic behavior —
// adding a bookmark, generating a short slug, and persisting to the browser —
// must run ONLY in the client-side <script> boundary at the bottom of this
// file. Astro runs that script in the browser, never during the build, so
// browser-only APIs are safe there.
//
// You will implement the behavior in Step 3.
---
<form id="add-bookmark">
  <div class="field">
    <label for="url">Link to save</label>
    <input
      id="url"
      name="url"
      type="text"
      inputmode="url"
      autocomplete="off"
      spellcheck="false"
      placeholder="https://example.com"
      required
    />
  </div>
  <button type="submit">Add bookmark</button>
</form>

<p class="hint">Paste a URL and select <strong>Add bookmark</strong> to generate its short <code>mona-</code> slug.</p>

<p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

<div id="list-header" hidden>
  <h2 class="list-title">Saved bookmarks</h2>
  <button id="clear-all" type="button" class="clear">Clear all</button>
</div>

<ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite">
  <!-- Bookmarks render here in the browser. -->
</ul>

<script>
  // CLIENT-SIDE BOUNDARY — runs in the browser only.
  // Bookmarks persist in localStorage via loadBookmarks and saveBookmarks utilities.
  // Import utilities; these remain pure and don't access browser APIs.
  import {
    normalizeUrl,
    generateSlug,
    formatBookmark,
    loadBookmarks,
    saveBookmarks,
    addBookmark as addBookmarkUtil,
  } from '../utils/bookmarks.ts';

  // Bookmark storage key and DOM element selectors.
  const STORAGE_KEY = 'mona-bookmarks';
  const form = document.getElementById('add-bookmark');
  const urlInput = document.getElementById('url');
  const emptyState = document.getElementById('empty-state');
  const listHeader = document.getElementById('list-header');
  const bookmarkList = document.getElementById('bookmark-list');
  const clearAllBtn = document.getElementById('clear-all');

  interface Bookmark {
    url: string;
    slug: string;
  }

  let bookmarks: Bookmark[] = [];

  /**
   * Render the bookmarks list in the DOM.
   */
  function renderBookmarks() {
    if (!bookmarkList) return;

    bookmarkList.innerHTML = '';
    bookmarks.forEach((bookmark) => {
      const li = document.createElement('li');
      li.className = 'bookmark';

      // URL as a link
      const urlLink = document.createElement('a');
      urlLink.href = bookmark.url;
      urlLink.target = '_blank';
      urlLink.rel = 'noopener noreferrer';
      urlLink.className = 'url';
      urlLink.textContent = bookmark.url;

      // Separator
      const separator = document.createElement('span');
      separator.textContent = ' :: ';

      // Slug badge
      const slugBadge = document.createElement('span');
      slugBadge.className = 'slug';
      slugBadge.textContent = bookmark.slug;

      // Copy button
      const copyBtn = document.createElement('button');
      copyBtn.type = 'button';
      copyBtn.className = 'copy';
      copyBtn.textContent = 'Copy';
      copyBtn.addEventListener('click', () => {
        navigator.clipboard.writeText(bookmark.slug).catch(() => {});
      });

      li.appendChild(urlLink);
      li.appendChild(separator);
      li.appendChild(slugBadge);
      li.appendChild(copyBtn);

      bookmarkList.appendChild(li);
    });

    updateUI();
  }

  /**
   * Update UI state (empty vs. list).
   */
  function updateUI() {
    const isEmpty = bookmarks.length === 0;
    if (emptyState) emptyState.hidden = !isEmpty;
    if (listHeader) listHeader.hidden = isEmpty;
  }

  /**
   * Load bookmarks from storage on page load.
   */
  function loadStoredBookmarks() {
    if (typeof localStorage === 'undefined') {
      bookmarks = [];
      renderBookmarks();
      return;
    }

    bookmarks = loadBookmarks();
    renderBookmarks();
  }

  /**
   * Handle form submit.
   */
  function handleSubmit(event: Event) {
    event.preventDefault(); // CRITICAL: stop page reload before anything else.

    if (!urlInput || !(urlInput instanceof HTMLInputElement)) return;

    const urlValue = urlInput.value.trim();
    const newBookmark = addBookmarkUtil(urlValue, bookmarks);

    if (!newBookmark) {
      // Duplicate or invalid — silently ignore.
      return;
    }

    bookmarks.push(newBookmark);
    saveBookmarks(bookmarks);
    renderBookmarks();

    // Clear input for next entry.
    urlInput.value = '';
    urlInput.focus();
  }

  /**
   * Handle clear all.
   */
  function handleClearAll() {
    if (!confirm('Clear all bookmarks? This cannot be undone.')) {
      return;
    }
    bookmarks = [];
    saveBookmarks(bookmarks);
    renderBookmarks();
  }

  // Initialize on page load.
  loadStoredBookmarks();

  // Wire event listeners.
  form?.addEventListener('submit', handleSubmit);
  clearAllBtn?.addEventListener('click', handleClearAll);
</script>
